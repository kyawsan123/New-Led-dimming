#include <xc.h>

// Configuration Bits
#pragma config FOSC = INTRC_NOCLKOUT // Internal Oscillator
#pragma config WDTE = OFF            // Watchdog Timer OFF
#pragma config PWRTE = OFF           // Power-up Timer OFF
#pragma config MCLRE = ON            // MCLR Pin Enabled (Pin 1 ကို 5V ပေးရမည်)
#pragma config CP = OFF              // Code Protection OFF
#pragma config CPD = OFF             // Data Code Protection OFF
#pragma config BOREN = OFF           // Brown Out Reset OFF
#pragma config IESO = OFF            // Internal External Switchover OFF
#pragma config FCMEN = OFF           // Fail-Safe Clock Monitor OFF
#pragma config LVP = OFF             // Low Voltage Programming OFF

#define _XTAL_FREQ 4000000 // 4MHz

// Buttons Input Mapping
#define BTN_POWER    RA0
#define BTN_DIM      RA1
#define BTN_UP       RA2
#define BTN_DOWN     RA3

// Global Variables
volatile unsigned int timer_minutes = 0;
volatile unsigned int seconds_counter = 0;
unsigned char pwr_status = 0; 
unsigned char dim_level = 0; // 0 = Low, 1 = Medium, 2 = High

// Button State Flags
unsigned char btn_pwr_pressed = 0;
unsigned char btn_dim_pressed = 0;
unsigned char btn_up_pressed = 0;
unsigned char btn_dn_pressed = 0;

// Common Cathode 7-Segment Codes
unsigned char segment_code[] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};

void setup(void);
void update_system_outputs(void);
void display_process(void);

// Timer1 Interrupt (100ms interval)
void __interrupt() isr(void) {
    if (TMR1IF) {
        TMR1H = 0x0B; TMR1L = 0xDC; // Reload
        
        if (pwr_status && timer_minutes > 0) {
            seconds_counter++;
            if (seconds_counter >= 600) { 
                timer_minutes--;
                seconds_counter = 0;
                if (timer_minutes == 0) {
                    pwr_status = 0; 
                }
            }
        }
        TMR1IF = 0;
    }
}

void main(void) {
    setup();
    
    while(1) {
        // -------------------------------------------------------------
        // ၁။ Power On/Off Button Logic (Dimming Low ဖြင့် စတင်ရန် ပြင်ဆင်ထားသောနေရာ)
        // -------------------------------------------------------------
        if (BTN_POWER == 0) {
            if (btn_pwr_pressed == 0) { 
                pwr_status = !pwr_status;
                if (pwr_status) {
                    dim_level = 0;       // Power On ချိန်တွင် Dimming Level ကို Low (0) သို့ သတ်မှတ်
                    timer_minutes = 0;   // အစပိုင်းတွင် Timer မသုံးသေးပါ (--:-- ပြရန်)
                    update_system_outputs(); // မီးဆိုင်းနှင့် Duty Cycle ကို Low အခြေအနေချက်ချင်းပြောင်းရန်
                }
                btn_pwr_pressed = 1; 
            }
        } else {
            btn_pwr_pressed = 0; 
        }

        if (pwr_status) {
            // -------------------------------------------------------------
            // ၂။ Dimming Button Logic (အဆင့်ဆင့်ပြောင်းလဲခြင်း)
            // -------------------------------------------------------------
            if (BTN_DIM == 0) {
                if (btn_dim_pressed == 0) {
                    dim_level++;
                    if (dim_level > 2) dim_level = 0;
                    update_system_outputs(); // ခလုတ်နှိပ်လိုက်တာနဲ့ အလင်းအမှောင် ချက်ချင်းပြောင်းရန်
                    btn_dim_pressed = 1; 
                }
            } else {
                btn_dim_pressed = 0; 
            }

            // -------------------------------------------------------------
            // ၃။ Timer Up Button Logic
            // -------------------------------------------------------------
            if (BTN_UP == 0) {
                if (btn_up_pressed == 0) {
                    if (timer_minutes < 180) timer_minutes += 5;
                    seconds_counter = 0;
                    btn_up_pressed = 1;
                }
            } else {
                btn_up_pressed = 0;
            }

            // -------------------------------------------------------------
            // ၄။ Timer Down Button Logic
            // -------------------------------------------------------------
            if (BTN_DOWN == 0) {
                if (btn_dn_pressed == 0) {
                    if (timer_minutes >= 5) timer_minutes -= 5;
                    btn_dn_pressed = 1;
                }
            } else {
                btn_dn_pressed = 0;
            }
            
        } else {
            // စနစ်ပိတ်ထားချိန်တွင် Output အားလုံးကို ပိတ်ထားမည်
            CCPR1L = 0;
            PORTC &= 0x07; 
        }

        // Display သို့ အဆက်မပြတ် Data ပို့ပေးနေခြင်း
        display_process(); 
    }
}

void setup(void) {
    ANSEL = 0; ANSELH = 0; // All Digital I/O
    
    TRISA = 0x0F; // RA0-RA3 Inputs, RA4-RA5 Outputs
    TRISB = 0x00; // PORTB Outputs (Segment Lines)
    TRISC = 0x00; // PORTC Outputs 
    
    PORTB = 0x00;
    PORTA |= 0x30; 
    PORTC |= 0x03; 
    
    // PWM Config
    T2CON = 0x04;  
    PR2 = 255;     
    CCP1CON = 0x0C;
    
    // Timer1 Config
    T1CON = 0x11;  
    TMR1H = 0x0B;  
    TMR1L = 0xDC;
    TMR1IE = 1; GIE = 1; PEIE = 1;
    
    update_system_outputs();
}

// Dimming Level အလိုက် Duty Cycle နှင့် မီးဆိုင်းများ ထိန်းချုပ်သည့် Function
void update_system_outputs(void) {
    if (!pwr_status) return;
    
    PORTC &= 0x07; // မီးဆိုင်းလိုင်းဟောင်းများ ရှင်းလင်းခြင်း
    
    if (dim_level == 0) { 
        CCPR1L = 40;        // Low Level (Duty Cycle နည်းနည်းဖြင့် မှိန်မှိန်လင်းမည်)
        PORTC |= 0x08;      // Low Level ပြမည့် အချက်ပြ LED မီး (RC3) ကို ဖွင့်ခြင်း
    } else if (dim_level == 1) { 
        CCPR1L = 80;       // Medium Level
        PORTC |= 0x10;      // Medium Level ပြမည့် အချက်ပြ LED မီး (RC4) ကို ဖွင့်ခြင်း
    } else { 
        CCPR1L = 200;       // High Level (အလင်းဆုံး)
        PORTC |= 0x20;      // High Level ပြမည့် အချက်ပြ LED မီး (RC5) ကို ဖွင့်ခြင်း
    }
}

void display_process(void) {
    if (!pwr_status) {
        PORTB = 0x00;
        PORTA |= 0x30; 
        PORTC |= 0x03; 
        return;
    }

    int hrs = timer_minutes / 60;
    int mins = timer_minutes % 60;
    int digits[4] = {hrs/10, hrs%10, mins/10, mins%10};

    for(int i=0; i<4; i++) {
        PORTA |= 0x30; 
        PORTC |= 0x03; 
        PORTB = 0x00; 

        if (timer_minutes == 0) {
            PORTB = 0x40; // Dash '-' ပြမည်
        } else {
            PORTB = segment_code[digits[i]]; 
        }
        
        if (i == 1) {
            PORTB |= 0x80; // အလယ်က ကော်လံစက် ( : ) ကို တွဲဖွင့်ခြင်း
        }
        
        if(i == 0)      RC0 = 0; 
        else if(i == 1) RC1 = 0; 
        else if(i == 2) RA4 = 0; 
        else            RA5 = 0; 
        
        __delay_ms(1); 
    }
    
    PORTA |= 0x30; 
    PORTC |= 0x03; 
}
