#include <xc.h>

// Configuration Bits
#pragma config FOSC = INTRC_NOCLKOUT 
#pragma config WDTE = OFF            
#pragma config PWRTE = OFF           
#pragma config MCLRE = ON            
#pragma config CP = OFF              
#pragma config CPD = OFF             
#pragma config BOREN = OFF           
#pragma config IESO = OFF            
#pragma config FCMEN = OFF           
#pragma config LVP = OFF             

#define _XTAL_FREQ 4000000 // 4MHz

// Buttons Input Mapping
#define BTN_POWER    RA0
#define BTN_DIM      RA1
#define BTN_UP       RA2
#define BTN_DOWN     RA3

// Global Variables
volatile unsigned int timer_minutes = 0;
volatile unsigned int seconds_counter = 0;
unsigned char pwr_status = 0; 
unsigned char dim_level = 0; 

// Button State Flags (ခလုတ်ကို တစ်ချက်နှိပ်ရင် တစ်ခါပဲအလုပ်လုပ်စေရန်)
unsigned char btn_pwr_pressed = 0;
unsigned char btn_dim_pressed = 0;
unsigned char btn_up_pressed = 0;
unsigned char btn_dn_pressed = 0;

// Common Cathode 7-Segment Codes
unsigned char segment_code[] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};

void setup(void);
void update_system_outputs(void);
void display_process(void);

// Timer1 Interrupt (100ms interval)
void __interrupt() isr(void) {
    if (TMR1IF) {
        TMR1H = 0x0B; TMR1L = 0xDC; // Reload
        
        if (pwr_status && timer_minutes > 0) {
            seconds_counter++;
            if (seconds_counter >= 600) { 
                timer_minutes--;
                seconds_counter = 0;
                if (timer_minutes == 0) {
                    pwr_status = 0; 
                }
            }
        }
        TMR1IF = 0;
    }
}

void main(void) {
    setup();
    
    while(1) {
        // -------------------------------------------------------------
        // ၁။ Power On/Off Button Logic (Flicker-Free)
        // -------------------------------------------------------------
        if (BTN_POWER == 0) {
            if (btn_pwr_pressed == 0) { // ကနဦး နှိပ်လိုက်တဲ့အချိန် သီးသန့်
                pwr_status = !pwr_status;
                if (pwr_status) {
                    dim_level = 0;       
                    timer_minutes = 0;   
                }
                btn_pwr_pressed = 1; // ခလုတ်ပြန်မလွှတ်မချင်း ထပ်မလုပ်စေရန် Block ထားမည်
            }
        } else {
            btn_pwr_pressed = 0; // ခလုတ်လွှတ်လိုက်မှ အလံပြန်ချမည်
        }

        if (pwr_status) {
            // -------------------------------------------------------------
            // ၂။ Dimming Button Logic (အဓိက ပြင်ဆင်ထားသောနေရာ - လုံးဝမတုန်တော့ပါ)
            // -------------------------------------------------------------
            if (BTN_DIM == 0) {
                if (btn_dim_pressed == 0) {
                    dim_level++;
                    if (dim_level > 2) dim_level = 0;
                    update_system_outputs(); // နှိပ်လိုက်တာနဲ့ output ကို ချက်ချင်းပြောင်း
                    btn_dim_pressed = 1; 
                }
            } else {
                btn_dim_pressed = 0; 
            }

            // -------------------------------------------------------------
            // ၃။ Timer Up Button Logic (Flicker-Free)
            // -------------------------------------------------------------
            if (BTN_UP == 0) {
                if (btn_up_pressed == 0) {
                    if (timer_minutes < 180) timer_minutes += 5;
                    seconds_counter = 0;
                    btn_up_pressed = 1;
                }
            } else {
                btn_up_pressed = 0;
            }

            // -------------------------------------------------------------
            // ၄။ Timer Down Button Logic (Flicker-Free)
            // -------------------------------------------------------------
            if (BTN_DOWN == 0) {
                if (btn_dn_pressed == 0) {
                    if (timer_minutes >= 5) timer_minutes -= 5;
                    btn_dn_pressed = 1;
                }
            } else {
                btn_dn_pressed = 0;
            }
            
        } else {
            CCPR1L = 0;
            PORTC &= 0x07; 
        }

        // ဘာပဲဖြစ်ဖြစ် ဒီ display_process() က loop ပတ်တိုင်း တားဆီးမှုမရှိ အမြဲ run နေမည်
        display_process(); 
    }
}

void setup(void) {
    ANSEL = 0; ANSELH = 0; 
    
    TRISA = 0x0F; 
    TRISB = 0x00; 
    TRISC = 0x00; 
    
    PORTB = 0x00;
    PORTA |= 0x30; 
    PORTC |= 0x03; 
    
    // PWM Config
    T2CON = 0x04;  
    PR2 = 255;     
    CCP1CON = 0x0C;
    
    // Timer1 Config
    T1CON = 0x11;  
    TMR1H = 0x0B;  
    TMR1L = 0xDC;
    TMR1IE = 1; GIE = 1; PEIE = 1;
    
    update_system_outputs();
}

void update_system_outputs(void) {
    if (!pwr_status) return;
    
    PORTC &= 0x07; 
    if (dim_level == 0) { 
        CCPR1L = 50;        
        PORTC |= 0x08;      
    } else if (dim_level == 1) { 
        CCPR1L = 150;       
        PORTC |= 0x10;      
    } else { 
        CCPR1L = 255;       
        PORTC |= 0x20;      
    }
}

void display_process(void) {
    if (!pwr_status) {
        PORTB = 0x00;
        PORTA |= 0x30; 
        PORTC |= 0x03; 
        return;
    }

    int hrs = timer_minutes / 60;
    int mins = timer_minutes % 60;
    int digits[4] = {hrs/10, hrs%10, mins/10, mins%10};

    for(int i=0; i<4; i++) {
        PORTA |= 0x30; 
        PORTC |= 0x03; 
        PORTB = 0x00; 

        if (timer_minutes == 0) {
            PORTB = 0x40; 
        } else {
            PORTB = segment_code[digits[i]]; 
        }
        
        if (i == 1) {
            PORTB |= 0x80; 
        }
        
        if(i == 0)      RC0 = 0; 
        else if(i == 1) RC1 = 0; 
        else if(i == 2) RA4 = 0; 
        else            RA5 = 0; 
        
        __delay_ms(1); // Refresh Rate ပိုမြန်အောင် 1ms သို့ လျှော့ချထားသည်
    }
    
    PORTA |= 0x30; 
    PORTC |= 0x03; 
}
