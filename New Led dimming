#include <xc.h>

// Configuration Bits
#pragma config FOSC = INTRC_NOCLKOUT // Internal Oscillator
#pragma config WDTE = OFF            // Watchdog Timer OFF
#pragma config PWRTE = OFF           // Power-up Timer OFF
#pragma config MCLRE = ON            // MCLR Pin Enabled (Pin 1 ကို 5V ပေးရမည်)
#pragma config CP = OFF              // Code Protection OFF
#pragma config CPD = OFF             // Data Code Protection OFF
#pragma config BOREN = OFF           // Brown Out Reset OFF
#pragma config IESO = OFF            // Internal External Switchover OFF
#pragma config FCMEN = OFF           // Fail-Safe Clock Monitor OFF
#pragma config LVP = OFF             // Low Voltage Programming OFF

#define _XTAL_FREQ 4000000 // 4MHz

// Buttons Input Mapping
#define BTN_POWER    RA0
#define BTN_DIM      RA1
#define BTN_UP       RA2
#define BTN_DOWN     RA3

// Global Variables
volatile unsigned int timer_minutes = 0;
volatile unsigned int seconds_counter = 0;
unsigned char pwr_status = 0; 
unsigned char dim_level = 0; 

// Common Cathode 7-Segment Codes (0-9)
unsigned char segment_code[] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};

void setup(void);
void update_system_outputs(void);
void display_process(void);

// Timer1 Interrupt (100ms interval)
void __interrupt() isr(void) {
    if (TMR1IF) {
        TMR1H = 0x0B; TMR1L = 0xDC; // Reload for 100ms
        
        if (pwr_status && timer_minutes > 0) {
            seconds_counter++;
            if (seconds_counter >= 600) { // 60 seconds (1 minute)
                timer_minutes--;
                seconds_counter = 0;
                if (timer_minutes == 0) {
                    pwr_status = 0; // အချိန်ပြည့်လျှင် ပိတ်မည်
                }
            }
        }
        TMR1IF = 0;
    }
}

void main(void) {
    setup();
    
    while(1) {
        // 1. Power On/Off Logic
        if (BTN_POWER == 0) {
            __delay_ms(40);
            if (BTN_POWER == 0) {
                pwr_status = !pwr_status;
                if (pwr_status) {
                    dim_level = 0;       
                    timer_minutes = 0;   // အစပိုင်းတွင် Timer မသုံးသေးပါ (--:-- ပြရန်)
                }
                while(!BTN_POWER) display_process();
            }
        }

        if (pwr_status) {
            // 2. Dimming Logic
            if (BTN_DIM == 0) {
                __delay_ms(40);
                if (BTN_DIM == 0) {
                    dim_level++;
                    if (dim_level > 2) dim_level = 0;
                    while(!BTN_DIM) display_process();
                }
            }

            // 3. Timer Up Button Logic
            if (BTN_UP == 0) {
                __delay_ms(40);
                if (timer_minutes < 180) timer_minutes += 5;
                seconds_counter = 0;
                while(!BTN_UP) display_process();
            }

            // 4. Timer Down Button Logic
            if (BTN_DOWN == 0) {
                __delay_ms(40);
                if (timer_minutes >= 5) timer_minutes -= 5;
                while(!BTN_DOWN) display_process();
            }
            
            update_system_outputs(); 
        } else {
            CCPR1L = 0;
            PORTC &= 0x07; 
        }

        display_process(); 
    }
}

void setup(void) {
    ANSEL = 0; ANSELH = 0; // All Digital I/O
    
    TRISA = 0x0F; // RA0-RA3 Inputs, RA4-RA5 Outputs
    TRISB = 0x00; // PORTB Outputs (Segment Lines A-G + DP/Colon)
    TRISC = 0x00; // PORTC Outputs 
    
    PORTB = 0x00;
    
    // Control pins အားလုံးကို HIGH ပေးပြီး အစပိုင်းတွင် Display ခေတ္တပိတ်ထားမည်
    PORTA |= 0x30; // RA4, RA5 = 1
    PORTC |= 0x03; // RC0, RC1 = 1
    
    // PWM Config
    T2CON = 0x04;  
    PR2 = 255;     
    CCP1CON = 0x0C;
    
    // Timer1 Config (100ms)
    T1CON = 0x11;  
    TMR1H = 0x0B;  
    TMR1L = 0xDC;
    TMR1IE = 1; GIE = 1; PEIE = 1;
}

void update_system_outputs(void) {
    PORTC &= 0x07; 
    if (dim_level == 0) { 
        CCPR1L = 50;        
        PORTC |= 0x08;      
    } else if (dim_level == 1) { 
        CCPR1L = 150;       
        PORTC |= 0x10;      
    } else { 
        CCPR1L = 255;       
        PORTC |= 0x20;      
    }
}

// အလယ်က ( : ) စက် ပေါ်စေရန် ပြင်ဆင်ထားသော Function
void display_process(void) {
    if (!pwr_status) {
        PORTB = 0x00;
        PORTA |= 0x30; 
        PORTC |= 0x03; 
        return;
    }

    int hrs = timer_minutes / 60;
    int mins = timer_minutes % 60;
    int digits[4] = {hrs/10, hrs%10, mins/10, mins%10};

    for(int i=0; i<4; i++) {
        // All Digits OFF 
        PORTA |= 0x30; 
        PORTC |= 0x03; 

        // Segment Data Output 
        if (timer_minutes == 0) {
            PORTB = 0x40; // Dash '-' ပြမည်
        } else {
            PORTB = segment_code[digits[i]]; 
        }
        
        // အလယ်က Colon ( : ) စက် ပေါ်စေရန်အတွက် Logic ဖြည့်စွက်ခြင်း
        // 5463AS-1 ၏ wiring အရ Digit 2 (i=1) ပွင့်ချိန်တွင် RB7 (DP Pin) ကိုပါ တွဲဖွင့်ပေးရပါမည်
        if (i == 1) {
            PORTB |= 0x80; // RB7 (Pin 28) ကို HIGH ပေးပြီး Colon စက်ကို ဖွင့်ခြင်း
        }
        
        // 5463AS-1 Display Pins Drive Configuration
        if(i == 0)      RC0 = 0; // Digit 1 -> Display Pin 12
        else if(i == 1) RC1 = 0; // Digit 2 -> Display Pin 9
        else if(i == 2) RA4 = 0; // Digit 3 -> Display Pin 8
        else            RA5 = 0; // Digit 4 -> Display Pin 6
        
        __delay_ms(1); 
    }
}
